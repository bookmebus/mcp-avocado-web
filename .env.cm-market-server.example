# cm-market-server MCP target — copy to `.env.cm-market-server` (gitignored).
# Read by src/mcp_targets/cm_market_server/config.py (SettingsStore, prefix CM_MARKET_SERVER_).
# ONLY this target's vars live here: `polymcp cm-market-server` needs no other file.

# Local cm-market-server checkout (Spree + spree_cm_commissioner gem).
CM_MARKET_SERVER_PATH=/path/to/cm-market-server

# Display metadata reported by the `health` tool (override config.py defaults).
# CM_MARKET_SERVER_DESCRIPTION=Your service — one-line description
# CM_MARKET_SERVER_SERVER_NAME=your-service   # (double SERVER_ is from the slug)
# CM_MARKET_SERVER_VERSION=0.1.0              # defaults to the build version

# --- Roadmap Step 5: read-only DB. Put REAL values in .env.cm-market-server only. ---
# cm-market-server is Postgres 18. Use a SELECT-only role.
# CM_MARKET_SERVER_DSN=postgresql+psycopg://mcp_ro:CHANGE_ME@127.0.0.1:5432/cm_market
