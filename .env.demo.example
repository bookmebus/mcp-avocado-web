# demo target — copy to `.env.demo` (gitignored) and adjust. Entirely optional:
# the demo runs with no env file at all (every field has a default).
# Read by src/mcp_targets/demo/config.py (SettingsStore, prefix DEMO_).

# Greeting prefix used by the greet() tool.
DEMO_GREETING=Hello

# Display metadata reported by the `health` tool (override config.py defaults).
# DEMO_DESCRIPTION=A minimal example target
# DEMO_SERVER_NAME=demo
# DEMO_VERSION=0.1.0     # defaults to the build version
