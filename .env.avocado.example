# avocado-web MCP target — copy to `.env.avocado` (gitignored) and adjust.
# Read by src/mcp_targets/avocado/config.py (SettingsStore, prefix AVOCADO_).
# ONLY this target's vars live here: `polymcp avocado` needs no other file.

# Local avocado-web checkout. Default: a sibling `avocado-web` next to this repo.
AVOCADO_WEB_PATH=/path/to/avocado-web

# Display metadata reported by the `health` tool (rebrand/re-version via config,
# no code change). Defaults live in config.py; these override them.
# AVOCADO_DESCRIPTION=Your service — one-line description
# AVOCADO_SERVER_NAME=your-service
# AVOCADO_VERSION=0.1.0     # defaults to the build version; set only to override

# --- Roadmap Step 5: read-only DB + staging API. Put REAL values in .env.avocado
# only — never here, never in git. ---
# avocado-web is MySQL 8.4 (mysql_native_password). Use a SELECT-only user.
# AVOCADO_WEB_DSN=mysql+pymysql://mcp_ro:CHANGE_ME@127.0.0.1:3306/avocado
# AVOCADO_API_BASE_URL=https://stg-bookmebus.com
# AVOCADO_CLIENT_ID=
# AVOCADO_CLIENT_SECRET=
